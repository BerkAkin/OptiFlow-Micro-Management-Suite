{
  "Routes": [
  //AUTH
    {
      "DownstreamPathTemplate": "/api/{everyting}/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-module",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/{everything}/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

  //FINANCE
    {
      "DownstreamPathTemplate": "/api/{everything}/{everything}",
